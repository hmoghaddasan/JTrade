# frontend/.env

# پورت سرور
PORT=3000

# آدرس بک‌اند
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000/ws/

# ✅ تنظیمات برای رفع خطای allowedHosts
DANGEROUSLY_DISABLE_HOST_CHECK=true

# ✅ تنظیمات برای رفع خطای ESLint
ESLINT_NO_DEV_ERRORS=true

# ✅ تنظیمات برای رفع خطای Source Map
GENERATE_SOURCEMAP=false

# ✅ تنظیمات برای رفع خطای memory
NODE_OPTIONS=--max_old_space_size=4096

# ✅ تنظیمات Fast Refresh
FAST_REFRESH=true

# ✅ تنظیمات برای رفع خطای MIME type
SKIP_PREFLIGHT_CHECK=true

# ✅ تنظیمات برای رفع خطای WebSocket
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000